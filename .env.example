# Local CLI only. Never configure payer keys or gateway tokens on the public site.
VERUN_CLIENT_CONFIG_FILE=/absolute/private/client.config.json
VERUN_GATEWAY_TOKEN_FILE=/absolute/private/gateway-token
SOLANA_PAYER_KEYPAIR_FILE=/absolute/private/devnet-payer.keypair.json
# Export these variables in your shell; the CLI does not auto-load .env.
PORT=3010
