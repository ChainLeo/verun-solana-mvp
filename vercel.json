{
  "version": 2,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/score",
      "destination": "/api/score"
    },
    {
      "source": "/evaluate",
      "destination": "/api/evaluate"
    },
    {
      "source": "/validators",
      "destination": "/api/validators"
    },
    {
      "source": "/mint-sbt",
      "destination": "/api/mint-sbt"
    },
    {
      "source": "/revoke-sbt",
      "destination": "/api/revoke-sbt"
    },
    {
      "source": "/sbt-status",
      "destination": "/api/sbt-status"
    },
    {
      "source": "/sbt-list",
      "destination": "/api/sbt-list"
    },
    {
      "source": "/config-check",
      "destination": "/api/config-check"
    },
    {
      "source": "/funding-status",
      "destination": "/api/funding-status"
    }
  ]
}
